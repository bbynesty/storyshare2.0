{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && mkdir -p build && cd build && cmake .. && cmake --build ."
  },
  "deploy": {
    "startCommand": "cd backend/build && ./server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

